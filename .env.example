# ─────────────────────────────────────────────────────────────────────────────
# Everything here is optional except where marked. The app builds, deploys and
# runs the scanner with NONE of these set — it simply keeps less and does less.
# Set them in Vercel under Project → Settings → Environment Variables.
# Never commit a filled-in copy of this file.
# ─────────────────────────────────────────────────────────────────────────────

# ── AI research (optional) ───────────────────────────────────────────────────
# Without it: scanning, filtering, risk and scoring all still work. Only the
# written research report is unavailable, and the UI says so.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# ── Persistent storage (optional for a first deploy, required for phase 2) ───
# Without it: the scanner runs and the dashboard shows the result, but nothing
# is kept — no history, no paper trades, no performance statistics.
# Run supabase/migrations/001_initial.sql and 002_scanner.sql in the SQL editor.
# The service role key is server-side only. Never prefix it with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Scheduled scanning (recommended) ─────────────────────────────────────────
# Protects /api/scan. Without it the endpoint is open to anyone who finds the
# URL, and the dashboard warns about that. Any long random string works.
CRON_SECRET=

# ── On-chain intelligence (phase 3, not used yet) ────────────────────────────
# Holder concentration, dev wallets, mint/freeze authority, LP status.
HELIUS_API_KEY=
BIRDEYE_API_KEY=

# ── Social intelligence (phase 4, not used yet) ──────────────────────────────
X_BEARER_TOKEN=

# ── Deployment ───────────────────────────────────────────────────────────────
# Only needed if something has to build absolute links back to the app.
NEXT_PUBLIC_APP_URL=
